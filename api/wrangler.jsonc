{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maktabah-demo-api",
  "account_id": "5ccf9a4d4e95e81bc260f3be4a49bcaf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "build": {
    "command": "bun run docs:prepare"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
