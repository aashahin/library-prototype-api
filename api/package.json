{
  "name": "maktabah-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bunx wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "bunx wrangler deploy",
    "build": "bunx wrangler deploy --dry-run --outdir dist",
    "docs:prepare": "bun scripts/prepare-docs.mjs",
    "docs:test": "bun scripts/test-docs.mjs",
    "types": "bunx wrangler types --env-interface CloudflareBindings",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "covers": "bun scripts/generate-covers.mjs",
    "smoke": "bun scripts/smoke.mjs",
    "pages:build": "bun scripts/build-prototype.mjs",
    "prototype:test": "bun scripts/test-prototype.mjs",
    "pages:deploy": "bun run pages:build && CLOUDFLARE_ACCOUNT_ID=5ccf9a4d4e95e81bc260f3be4a49bcaf bunx wrangler pages deploy dist/prototype --project-name maktabah-prototype --branch main"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.7",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@scalar/api-reference": "1.72.2",
    "@types/bun": "^1.4.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.144.0"
  }
}
